DJANGO_DEBUG=true
DJANGO_SECRET_KEY=replace-with-a-long-random-secret
DATA_ENCRYPTION_KEY=generate-with-cryptography-fernet-key
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:3000,https://my.techinn.co.zw
FRONTEND_BASE_URL=https://my.techinn.co.zw
GOOGLE_OAUTH_CLIENT_ID=

# Configure an outbound email provider to enable password reset emails.
EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
EMAIL_HOST=mail.techinn.co.zw
EMAIL_PORT=465
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=false
EMAIL_USE_SSL=true
DEFAULT_FROM_EMAIL=

# Local development defaults to SQLite. Set DB_ENGINE=mysql for MySQL/MariaDB.
DB_ENGINE=sqlite
DB_NAME=techinn
SQLITE_PATH=/var/lib/techinn-api/db.sqlite3
DB_USER=techinn
DB_PASSWORD=
DB_HOST=127.0.0.1
DB_PORT=3306

# Optional TechInn-managed Cloudflare connection (customer tokens are stored encrypted).
CLOUDFLARE_CONNECTION_NAME=TechInn Cloudflare
CLOUDFLARE_API_TOKEN=
# Alternative for the existing TechInn global Cloudflare account:
CLOUDFLARE_EMAIL=
CLOUDFLARE_KEY=
CLOUDFLARE_ACCOUNT_ID=

# TechInn-managed CyberPanel connection. Use the panel hostname so TLS validates.
CYBERPANEL_API_URL=https://panel.techinn.co.zw:8090
CYBERPANEL_API_USER=
CYBERPANEL_API_PASSWORD=
CYBERPANEL_PACKAGE_WEB_BASIC=TechInn-Basic-2GB
CYBERPANEL_PACKAGE_WEB_GROWTH=TechInn-Growth-10GB
CYBERPANEL_PACKAGE_WEB_BUSINESS=TechInn-Business-25GB
CYBERPANEL_PHP=PHP 8.2

ZISPA_API_URL=
ZISPA_API_KEY=
ZISPA_DRAFT_API_KEY=
ZISPA_AUTO_SEND=false
ZISPA_SUBMISSIONS_ENABLED=false
ZISPA_DEFAULT_NAMESERVERS=[]

# Paynow credentials are server-side only. Never add them to the Next.js environment.
PAYNOW_ID=
PAYNOW_KEY=
PAYNOW_EMAIL=
# Optional: defaults to the frontend checkout URL and this API's signed callback URL.
PAYNOW_RETURN_URL=
PAYNOW_RESULT_URL=
