[Unit]
Description=Import matched active CyberPanel websites into my.techinn.co.zw
After=network-online.target

[Service]
Type=oneshot
User=root
Group=root
WorkingDirectory=/home/my.techinn.co.zw/launch-ui/backend
EnvironmentFile=/home/my.techinn.co.zw/launch-ui/backend/.env
ExecStart=/home/my.techinn.co.zw/launch-ui/backend/.venv/bin/python manage.py sync_cyberpanel_services
