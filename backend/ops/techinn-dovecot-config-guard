#!/usr/bin/env python3
"""Keep Dovecot startable when CyberPanel has a stale SNI certificate block."""
from __future__ import annotations

import os
import re
import shutil
import subprocess
import tempfile
from datetime import datetime, timezone
from pathlib import Path

CONFIG = Path("/etc/dovecot/dovecot.conf")
LOCAL_NAME = re.compile(r"^local_name\s+([^\s{]+)\s*\{\s*$")
CERT = re.compile(r"^\s*ssl_cert\s*=\s*<(.+)\s*$")
KEY = re.compile(r"^\s*ssl_key\s*=\s*<(.+)\s*$")


def guard() -> int:
    original = CONFIG.read_text()
    lines = original.splitlines(keepends=True)
    output: list[str] = []
    removed: list[str] = []
    index = 0
    while index < len(lines):
        match = LOCAL_NAME.match(lines[index].rstrip("\n"))
        if not match:
            output.append(lines[index])
            index += 1
            continue
        start = index
        depth = 0
        block: list[str] = []
        while index < len(lines):
            line = lines[index]
            block.append(line)
            depth += line.count("{") - line.count("}")
            index += 1
            if depth == 0:
                break
        cert_path = next((CERT.match(line).group(1).strip() for line in block if CERT.match(line)), None)
        key_path = next((KEY.match(line).group(1).strip() for line in block if KEY.match(line)), None)
        if cert_path and key_path and (not Path(cert_path).is_file() or not Path(key_path).is_file()):
            removed.append(match.group(1))
            continue
        output.extend(block)

    updated = "".join(output)
    if updated != original:
        backup = CONFIG.with_name(f"dovecot.conf.guard-{datetime.now(timezone.utc):%Y%m%d%H%M%S}")
        shutil.copy2(CONFIG, backup)
        fd, temp_name = tempfile.mkstemp(prefix="dovecot.conf.", dir=str(CONFIG.parent))
        try:
            with os.fdopen(fd, "w") as handle:
                handle.write(updated)
            os.chmod(temp_name, CONFIG.stat().st_mode & 0o777)
            os.replace(temp_name, CONFIG)
        finally:
            if os.path.exists(temp_name):
                os.unlink(temp_name)
        if removed:
            print("Removed stale Dovecot certificate blocks: " + ", ".join(removed))

    check = subprocess.run(
        ["/usr/bin/doveconf", "-n", "-c", str(CONFIG)],
        stdout=subprocess.DEVNULL,
        stderr=subprocess.PIPE,
        text=True,
        check=False,
    )
    if check.returncode:
        print(check.stderr.strip())
    return check.returncode


if __name__ == "__main__":
    raise SystemExit(guard())
